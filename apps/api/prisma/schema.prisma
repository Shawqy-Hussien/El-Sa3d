generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  CUSTOMER
  ADMIN
  PHARMACIST
  DELIVERY_AGENT
}

enum OneTimeTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  MEDICINE
  SUPPLEMENT
  PERSONAL_CARE
  MEDICAL_DEVICE
  OTHER
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RETURN
  RESERVED
  RELEASED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  PROCESSING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD
  WALLET
  BANK_TRANSFER
}

enum PrescriptionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PrescriptionReviewDecision {
  APPROVED
  REJECTED
}

enum DeliveryAssignmentStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(320)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  role                AccountRole          @default(CUSTOMER)
  emailVerifiedAt     DateTime?            @map("email_verified_at")
  disabledAt          DateTime?            @map("disabled_at")
  deletedAt           DateTime?            @map("deleted_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  roleAssignments     UserRole[]
  assignedRoles       UserRole[]           @relation("UserRoleAssignedBy")
  customerProfile     CustomerProfile?
  addresses           Address[]
  carts               Cart[]
  sessions            AuthSession[]
  oneTimeTokens       OneTimeToken[]
  authAuditEvents     AuthAuditEvent[]
  recentSearches      RecentSearch[]
  inventoryMovements  InventoryMovement[]  @relation("InventoryMovementActor")
  prescriptionReviews PrescriptionReview[] @relation("PrescriptionReviewer")
  orders              Order[]
  prescriptions       Prescription[]
  deliveryAssignments DeliveryAssignment[] @relation("DeliveryAgent")
  favorites           Favorite[]
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  auditLogs           AuditLog[]           @relation("AuditActor")

  @@index([deletedAt, disabledAt])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(64)
  name            String           @db.VarChar(120)
  description     String?          @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  userAssignments UserRole[]
  permissions     RolePermission[]

  @@index([name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId, userId])
  @@index([assignedById])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId, roleId])
  @@map("role_permissions")
}

model CustomerProfile {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String    @map("last_name") @db.VarChar(100)
  phone     String?   @unique @db.VarChar(32)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@map("customer_profiles")
}

model Address {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  label                String    @db.VarChar(80)
  recipientName        String    @map("recipient_name") @db.VarChar(160)
  phone                String    @db.VarChar(32)
  street               String    @db.VarChar(240)
  building             String?   @db.VarChar(80)
  apartment            String?   @db.VarChar(80)
  city                 String    @db.VarChar(120)
  governorate          String    @db.VarChar(120)
  postalCode           String?   @map("postal_code") @db.VarChar(24)
  deliveryInstructions String?   @map("delivery_instructions") @db.VarChar(500)
  isDefault            Boolean   @default(false) @map("is_default")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders               Order[]

  @@index([userId, deletedAt])
  @@index([userId, isDefault])
  @@map("addresses")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  name        String     @db.VarChar(160)
  slug        String     @unique @db.VarChar(180)
  description String?    @db.VarChar(500)
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId, sortOrder])
  @@index([isActive, deletedAt])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(160)
  slug        String    @unique @db.VarChar(180)
  description String?   @db.VarChar(500)
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@index([isActive, deletedAt])
  @@map("brands")
}

model Product {
  id                   String           @id @default(uuid()) @db.Uuid
  categoryId           String           @map("category_id") @db.Uuid
  brandId              String?          @map("brand_id") @db.Uuid
  name                 String           @db.VarChar(240)
  nameAr               String?          @map("name_ar") @db.VarChar(240)
  slug                 String           @unique @db.VarChar(260)
  description          String?          @db.VarChar(2000)
  activeIngredient     String?          @map("active_ingredient") @db.VarChar(240)
  activeIngredientAr   String?          @map("active_ingredient_ar") @db.VarChar(240)
  type                 ProductType      @default(OTHER)
  prescriptionRequired Boolean          @default(false) @map("prescription_required")
  status               ProductStatus    @default(DRAFT)
  deletedAt            DateTime?        @map("deleted_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  category             Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants             ProductVariant[]
  images               ProductImage[]
  favorites            Favorite[]

  @@index([categoryId, status, deletedAt])
  @@index([brandId, status, deletedAt])
  @@index([status, createdAt])
  @@map("products")
}

model ProductVariant {
  id                String              @id @default(uuid()) @db.Uuid
  productId         String              @map("product_id") @db.Uuid
  sku               String              @unique @db.VarChar(80)
  barcode           String?             @unique @db.VarChar(80)
  name              String              @db.VarChar(180)
  unitLabel         String              @map("unit_label") @db.VarChar(80)
  price             Decimal             @db.Decimal(12, 2)
  compareAtPrice    Decimal?            @map("compare_at_price") @db.Decimal(12, 2)
  currency          String              @default("EGP") @db.Char(3)
  isActive          Boolean             @default(true) @map("is_active")
  deletedAt         DateTime?           @map("deleted_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory         Inventory?
  movements         InventoryMovement[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  prescriptionItems PrescriptionItem[]

  @@index([productId, isActive, deletedAt])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(2048)
  altText   String?  @map("alt_text") @db.VarChar(240)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Inventory {
  id               String         @id @default(uuid()) @db.Uuid
  variantId        String         @unique @map("variant_id") @db.Uuid
  quantity         Int            @default(0)
  reservedQuantity Int            @default(0) @map("reserved_quantity")
  reorderLevel     Int            @default(0) @map("reorder_level")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([quantity, reorderLevel])
  @@map("inventory")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  variantId      String                @map("variant_id") @db.Uuid
  actorUserId    String?               @map("actor_user_id") @db.Uuid
  type           InventoryMovementType
  quantityChange Int                   @map("quantity_change")
  referenceType  String?               @map("reference_type") @db.VarChar(80)
  referenceId    String?               @map("reference_id") @db.Uuid
  reason         String?               @db.VarChar(500)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actor          User?                 @relation("InventoryMovementActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model RecentSearch {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  query          String   @db.VarChar(240)
  lastSearchedAt DateTime @default(now()) @map("last_searched_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
  @@index([userId, lastSearchedAt])
  @@map("recent_searches")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId, status, updatedAt])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id                      String              @id @default(uuid()) @db.Uuid
  orderNumber             String              @unique @map("order_number") @db.VarChar(40)
  userId                  String              @map("user_id") @db.Uuid
  addressId               String?             @map("address_id") @db.Uuid
  couponId                String?             @map("coupon_id") @db.Uuid
  status                  OrderStatus         @default(PENDING)
  subtotal                Decimal             @db.Decimal(12, 2)
  discountTotal           Decimal             @default(0) @map("discount_total") @db.Decimal(12, 2)
  deliveryFee             Decimal             @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  total                   Decimal             @db.Decimal(12, 2)
  currency                String              @default("EGP") @db.Char(3)
  shippingAddressSnapshot Json                @map("shipping_address_snapshot")
  customerNote            String?             @map("customer_note") @db.VarChar(1000)
  deletedAt               DateTime?           @map("deleted_at")
  placedAt                DateTime?           @map("placed_at")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  user                    User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  address                 Address?            @relation(fields: [addressId], references: [id], onDelete: SetNull)
  coupon                  Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  payments                Payment[]
  prescriptions           Prescription[]
  deliveryAssignment      DeliveryAssignment?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([couponId])
  @@map("orders")
}

model OrderItem {
  id                  String          @id @default(uuid()) @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  variantId           String?         @map("variant_id") @db.Uuid
  productNameSnapshot String          @map("product_name_snapshot") @db.VarChar(240)
  variantNameSnapshot String          @map("variant_name_snapshot") @db.VarChar(180)
  skuSnapshot         String          @map("sku_snapshot") @db.VarChar(80)
  unitPrice           Decimal         @map("unit_price") @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal         @map("line_total") @db.Decimal(12, 2)
  currency            String          @default("EGP") @db.Char(3)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("EGP") @db.Char(3)
  provider          String?       @db.VarChar(80)
  providerReference String?       @unique @map("provider_reference") @db.VarChar(160)
  failureCode       String?       @map("failure_code") @db.VarChar(100)
  metadata          Json?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

model Prescription {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  orderId     String?              @map("order_id") @db.Uuid
  status      PrescriptionStatus   @default(SUBMITTED)
  fileKey     String               @map("file_key") @db.VarChar(512)
  mimeType    String               @map("mime_type") @db.VarChar(100)
  deletedAt   DateTime?            @map("deleted_at")
  submittedAt DateTime             @default(now()) @map("submitted_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  order       Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items       PrescriptionItem[]
  reviews     PrescriptionReview[]

  @@index([userId, status, createdAt])
  @@index([orderId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                    String          @id @default(uuid()) @db.Uuid
  prescriptionId        String          @map("prescription_id") @db.Uuid
  variantId             String?         @map("variant_id") @db.Uuid
  requestedNameSnapshot String          @map("requested_name_snapshot") @db.VarChar(240)
  quantity              Int?
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  prescription          Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  variant               ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
  @@index([variantId])
  @@map("prescription_items")
}

model PrescriptionReview {
  id             String                     @id @default(uuid()) @db.Uuid
  prescriptionId String                     @map("prescription_id") @db.Uuid
  reviewerId     String                     @map("reviewer_id") @db.Uuid
  decision       PrescriptionReviewDecision
  note           String?                    @db.VarChar(2000)
  reviewedAt     DateTime                   @default(now()) @map("reviewed_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  prescription   Prescription               @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  reviewer       User                       @relation("PrescriptionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([prescriptionId, reviewedAt])
  @@index([reviewerId, reviewedAt])
  @@map("prescription_reviews")
}

model DeliveryAssignment {
  id          String                   @id @default(uuid()) @db.Uuid
  orderId     String                   @unique @map("order_id") @db.Uuid
  agentId     String                   @map("agent_id") @db.Uuid
  status      DeliveryAssignmentStatus @default(ASSIGNED)
  assignedAt  DateTime                 @default(now()) @map("assigned_at")
  acceptedAt  DateTime?                @map("accepted_at")
  pickedUpAt  DateTime?                @map("picked_up_at")
  deliveredAt DateTime?                @map("delivered_at")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  order       Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agent       User                     @relation("DeliveryAgent", fields: [agentId], references: [id], onDelete: Restrict)

  @@index([agentId, status, assignedAt])
  @@index([status, assignedAt])
  @@map("delivery_assignments")
}

model Coupon {
  id              String     @id @default(uuid()) @db.Uuid
  code            String     @unique @db.VarChar(80)
  type            CouponType
  value           Decimal    @db.Decimal(12, 2)
  minimumOrder    Decimal?   @map("minimum_order") @db.Decimal(12, 2)
  maximumDiscount Decimal?   @map("maximum_discount") @db.Decimal(12, 2)
  usageLimit      Int?       @map("usage_limit")
  usageCount      Int        @default(0) @map("usage_count")
  startsAt        DateTime   @map("starts_at")
  endsAt          DateTime   @map("ends_at")
  isActive        Boolean    @default(true) @map("is_active")
  deletedAt       DateTime?  @map("deleted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  orders          Order[]

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model Promotion {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(160)
  nameAr        String        @map("name_ar") @db.VarChar(160)
  description   String?       @db.VarChar(500)
  descriptionAr String?       @map("description_ar") @db.VarChar(500)
  type          PromotionType
  value         Decimal       @db.Decimal(12, 2)
  startsAt      DateTime      @map("starts_at")
  endsAt        DateTime      @map("ends_at")
  isActive      Boolean       @default(true) @map("is_active")
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model StorefrontBanner {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(180)
  titleAr     String    @map("title_ar") @db.VarChar(180)
  subtitle    String?   @db.VarChar(320)
  subtitleAr  String?   @map("subtitle_ar") @db.VarChar(320)
  imageUrl    String    @map("image_url") @db.VarChar(2048)
  href        String?   @db.VarChar(512)
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isActive, sortOrder, startsAt, endsAt])
  @@map("storefront_banners")
}

model Favorite {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, deletedAt])
  @@map("favorites")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel @default(IN_APP)
  status    NotificationStatus  @default(QUEUED)
  title     String              @db.VarChar(180)
  body      String              @db.VarChar(1000)
  readAt    DateTime?           @map("read_at")
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  tokenHash       String         @unique @map("token_hash") @db.Char(64)
  tokenCiphertext String         @map("token_ciphertext") @db.VarChar(2048)
  platform        DevicePlatform
  revokedAt       DateTime?      @map("revoked_at")
  lastUsedAt      DateTime?      @map("last_used_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("device_tokens")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(120)
  resourceType String   @map("resource_type") @db.VarChar(120)
  resourceId   String?  @map("resource_id") @db.VarChar(120)
  metadata     Json?
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  userAgent     String?        @map("user_agent") @db.VarChar(512)
  ipAddress     String?        @map("ip_address") @db.VarChar(45)
  createdAt     DateTime       @default(now()) @map("created_at")
  lastUsedAt    DateTime       @default(now()) @map("last_used_at")
  expiresAt     DateTime       @map("expires_at")
  revokedAt     DateTime?      @map("revoked_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id         String      @id @default(uuid()) @db.Uuid
  sessionId  String      @map("session_id") @db.Uuid
  tokenHash  String      @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime    @default(now()) @map("created_at")
  expiresAt  DateTime    @map("expires_at")
  consumedAt DateTime?   @map("consumed_at")
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
  @@map("refresh_tokens")
}

model OneTimeToken {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  tokenHash  String              @unique @map("token_hash") @db.Char(64)
  purpose    OneTimeTokenPurpose
  createdAt  DateTime            @default(now()) @map("created_at")
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@map("one_time_tokens")
}

model AuthAuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(64)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("auth_audit_events")
}
