# Express API listening port.
API_PORT=3001

# Prisma connection URL. Keep credentials aligned with the POSTGRES_* values below.
DATABASE_URL=postgresql://pharmacy_user:replace_me@localhost:5432/pharmacy_dev?schema=public

# PostgreSQL database name created by the local Docker Compose service.
POSTGRES_DB=pharmacy_dev

# Local-only PostgreSQL password. Replace this value in your untracked .env file.
POSTGRES_PASSWORD=replace_me

# Local PostgreSQL role used by the API and Docker Compose service.
POSTGRES_USER=pharmacy_user

# HMAC/JWT signing secret. Generate a unique value with at least 32 characters.
ACCESS_TOKEN_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# Access-token lifetime in minutes (1-60).
ACCESS_TOKEN_TTL_MINUTES=15

# Rotating refresh-token lifetime in days (1-90).
REFRESH_TOKEN_TTL_DAYS=30

# Password-reset token lifetime in minutes (5-120).
PASSWORD_RESET_TTL_MINUTES=30

# Email-verification token lifetime in hours (1-168).
EMAIL_VERIFICATION_TTL_HOURS=24

# Comma-separated web origins allowed to make credentialed API requests.
WEB_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Set true behind HTTPS in production; false is for local HTTP development.
COOKIE_SECURE=false

# Mail transport: console for local development or smtp for a real provider.
MAIL_TRANSPORT=console

# Sender address used by the mail transport.
MAIL_FROM=pharmacy@example.invalid

# SMTP server host (required only when MAIL_TRANSPORT=smtp).
SMTP_HOST=

# SMTP server port.
SMTP_PORT=587

# Enable TLS-on-connect when using an SMTP endpoint such as port 465.
SMTP_SECURE=false

# Optional SMTP authentication username; configure with SMTP_PASSWORD.
SMTP_USER=

# Optional SMTP authentication password; configure with SMTP_USER.
SMTP_PASSWORD=

# Image storage: local for development or s3 for an S3-compatible service.
STORAGE_DRIVER=local
STORAGE_DIRECTORY=storage/uploads
STORAGE_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=